<idea-plugin>
    <id>com.moduleloom</id>
    <name>ModuleLoom</name>
    <version>${pluginVersion}</version>
    <vendor url="https://github.com/tamon-ishii/module_loom">ModuleLoom</vendor>
    <idea-version since-build="253" />
    <description><![CDATA[
    Interactive Python module dependency graph visualization inside PyCharm.
    Detects circular imports, inspects oversized modules, and provides one-click navigation to editor files.
    ]]></description>

    <!-- Compatibility with all JetBrains IDEs (PyCharm, IntelliJ, etc.) -->
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.jcef</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="ModuleLoom"
                    anchor="right"
                    canCloseContents="false"
                    icon="/icons/moduleloom.svg"
                    factoryClass="com.moduleloom.ModuleLoomToolWindowFactory"/>
    </extensions>

    <actions>
        <action id="com.moduleloom.OpenInModuleLoomAction"
                class="com.moduleloom.OpenInModuleLoomAction"
                text="ModuleLoom で開く"
                description="ModuleLoom でモジュール依存関係ダイアグラムを開く"
                icon="/icons/moduleloom.svg">
            <!-- Project view tree context menu -->
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="RevealIn"/>
            <!-- Editor editor area context menu -->
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <!-- Editor tab header context menu -->
            <add-to-group group-id="EditorTabPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
