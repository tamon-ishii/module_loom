{
  "name": "moduleloom",
  "displayName": "ModuleLoom",
  "description": "Python module dependency visualization, code diagnostics, and automated documentation engine with AI",
  "version": "1.1.0",
  "publisher": "moduleloom",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Visualization", "Other"],
  "main": "./extension.js",
  "activationEvents": ["onCommand:moduleloom.openGraph"],
  "contributes": {
    "commands": [
      { "command": "moduleloom.openGraph", "title": "ModuleLoom: Open Module Graph" }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "moduleloom",
          "title": "ModuleLoom",
          "icon": "media/moduleloom.svg"
        }
      ]
    },
    "views": {
      "moduleloom": [
        { "id": "moduleloom.launch", "name": "Module Graph" }
      ]
    },
    "viewsWelcome": [
      {
        "view": "moduleloom.launch",
        "contents": "[Open ModuleLoom graph](command:moduleloom.openGraph)\n\nOpen a Python workspace to explore its module dependencies."
      }
    ],
    "configuration": {
      "title": "ModuleLoom",
      "properties": {
        "moduleloom.analyzerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the ModuleLoom analyze executable. Empty uses the workspace build or analyze from PATH."
        }
      }
    }
  },
  "files": ["extension.js", "media/**", "bin/**", "licenses/**", "README.md"]
}
